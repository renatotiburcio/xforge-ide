@using XForge.Ide.Application.Dto
@using XForge.Ide.Application.Services
@using XForge.Ide.App.Components
@using XForge.Ide.App.Services
@using XForge.DesignSystem.Components.Forms.Combobox
@inject DictionaryService Dictionaries
@inject IdeUiState Ui

<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
    <ChildContent>
        <XFStack Orientation="XFOrientation.Horizontal" Gap="3" AlignItems="XFAlignItems.Center">
            <XFTypography Variant="XFTypographyVariant.H3" Weight="XFTypographyWeight.Semibold">
                Entidade @_view.Name <span class="text-text-muted text-sm">(@_view.TableName)</span>
            </XFTypography>
            <XFButton Text="Adicionar campo" Variant="XFButtonVariant.Soft" Color="XFButtonColor.Primary"
                      OnClick="OpenFieldModalAsync" />
        </XFStack>

        @* ------------------------------------------------------------- Campos *@
        <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold" Class="mt-3">Campos</XFTypography>
        <XFTable Striped="true" Hoverable="true" Compact="true" Class="mt-2">
            <XFTableHeader>
                <XFTableRow>
                    <XFTableCell Header="true">#</XFTableCell>
                    <XFTableCell Header="true">Nome</XFTableCell>
                    <XFTableCell Header="true">Tipo CLR</XFTableCell>
                    <XFTableCell Header="true">DB</XFTableCell>
                    <XFTableCell Header="true">Tam.</XFTableCell>
                    <XFTableCell Header="true">Obrig.</XFTableCell>
                    <XFTableCell Header="true">Rótulo</XFTableCell>
                    <XFTableCell Header="true">Picture</XFTableCell>
                    <XFTableCell Header="true">Externo</XFTableCell>
                    <XFTableCell Header="true"></XFTableCell>
                </XFTableRow>
            </XFTableHeader>
            <XFTableBody>
                @foreach (var f in VisibleFields)
                {
                    <XFTableRow>
                        <XFTableCell>@f.SortOrder</XFTableCell>
                        <XFTableCell>@f.Name</XFTableCell>
                        <XFTableCell><span class="text-text-muted text-sm">@f.ClrType</span></XFTableCell>
                        <XFTableCell><span class="text-text-muted text-sm">@f.DbType</span></XFTableCell>
                        <XFTableCell>@(f.Length?.ToString() ?? "—")</XFTableCell>
                        <XFTableCell>@(f.Required ? "sim" : "não")</XFTableCell>
                        <XFTableCell>@f.Label</XFTableCell>
                        <XFTableCell><span class="text-text-muted text-sm">@(f.Picture ?? "—")</span></XFTableCell>
                        <XFTableCell><span class="text-text-muted text-sm">@(f.ExternalName ?? "—")</span></XFTableCell>
                        <XFTableCell>
                            @if (f.Name != "Id")
                            {
                                <XFButton Text="Remover" AriaLabel="@($"Remover campo {f.Name}")" Variant="XFButtonVariant.Soft" Color="XFButtonColor.Danger" Size="XFExtendedSize.Sm"
                                          OnClick="() => AskDeleteFieldAsync(f)" />
                            }
                        </XFTableCell>
                    </XFTableRow>
                }
            </XFTableBody>
        </XFTable>

        <DataPager TotalItems="_view.Fields.Count" Page="_fieldPage" PageSize="PageSize"
                   PageChanged="OnFieldPageChanged" />

        @* ------------------------------------------------------------- Chaves *@
        <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold" Class="mt-4">Chaves</XFTypography>
        <XFTable Striped="true" Hoverable="true" Compact="true" Class="mt-2">
            <XFTableHeader>
                <XFTableRow>
                    <XFTableCell Header="true">Nome</XFTableCell>
                    <XFTableCell Header="true">Primária</XFTableCell>
                    <XFTableCell Header="true">Única</XFTableCell>
                    <XFTableCell Header="true">Campos</XFTableCell>
                    <XFTableCell Header="true"></XFTableCell>
                </XFTableRow>
            </XFTableHeader>
            <XFTableBody>
                @foreach (var k in VisibleKeys)
                {
                    <XFTableRow>
                        <XFTableCell>@k.Name</XFTableCell>
                        <XFTableCell>@(k.IsPrimary ? "sim" : "não")</XFTableCell>
                        <XFTableCell>@(k.IsUnique ? "sim" : "não")</XFTableCell>
                        <XFTableCell><span class="text-text-muted text-sm">@k.FieldsJson</span></XFTableCell>
                        <XFTableCell>
                            @if (!k.IsPrimary)
                            {
                                <XFButton Text="Remover" AriaLabel="@($"Remover chave {k.Name}")" Variant="XFButtonVariant.Soft" Color="XFButtonColor.Danger" Size="XFExtendedSize.Sm"
                                          OnClick="() => AskDeleteKeyAsync(k)" />
                            }
                        </XFTableCell>
                    </XFTableRow>
                }
            </XFTableBody>
        </XFTable>

        <DataPager TotalItems="_view.Keys.Count" Page="_keyPage" PageSize="PageSize"
                   PageChanged="OnKeyPageChanged" />

        @if (_error is not null)
        {
            <div role="alert" aria-live="assertive"
                 class="mt-3 border border-danger/30 bg-danger/10 text-danger-text rounded-md px-4 py-2 text-sm">@_error</div>
        }
    </ChildContent>
</XFCard>

@* ======================================================= Modal: adicionar campo *@
<Modal Open="@_showFieldModal" OpenChanged="OnFieldModalChanged"
       Title="Adicionar campo" Description="Tipo CLR e DbType seguem as convencoes de Clean Architecture"
       ConfirmText="Adicionar campo" ConfirmAction="AddFieldAsync">
    <div class="grid gap-4 md:grid-cols-2">
        <XFTextInput Label="Nome *" Placeholder="Descricao"
                     Value="@_fieldName" ValueChanged="(string v) => _fieldName = v ?? string.Empty" />
        <XFCombobox TItem="string" TValue="string" Label="Tipo CLR" Placeholder="Selecione ou pesquise"
                    Items="@_clrTypes" TextSelector="@(t => t)" ValueSelector="@(t => t)"
                    Value="@_fieldType" ValueChanged="OnFieldTypeChanged" />
        <XFTextInput Label="Rótulo (opcional)" Placeholder="Descrição"
                     Value="@_fieldLabel" ValueChanged="(string v) => _fieldLabel = v" />
        <XFTextInput Label="Picture Clarion (opcional)" Placeholder="@@s50"
                     Value="@_fieldPicture" ValueChanged="(string v) => _fieldPicture = v" />
        <XFCheckbox Label="Obrigatório" Value="@_fieldRequired" ValueChanged="OnRequiredChanged" />
    </div>
</Modal>

@* ====================================================== Modal: confirmar exclusão *@
<ConfirmDialog Open="@_showDeleteConfirm" OpenChanged="OnDeleteConfirmChanged"
               Title="@_deleteTitle"
               ConfirmMessage="@($"O campo/chave será removido da entidade {_view.Name}.")"
               TargetName="@_deleteTargetName"
               ConfirmText="Remover"
               OnConfirm="DeleteConfirmedAsync" />

@code {
    [Parameter, EditorRequired] public EntityDto Entity { get; set; } = default!;

    /// <summary>Notifica a página pai para recarregar a entidade após alterações.</summary>
    [Parameter] public Func<Task>? Changed { get; set; }

    /// <summary>Cópia local recarregada após cada mutação (garante refresh imediato).</summary>
    private EntityDto _view = default!;

    /// <summary>Última instância de parâmetro recebida (evita sobrescrever dados mais novos).</summary>
    private EntityDto? _lastParam;

    private int _fieldPage = 1;
    private int _keyPage = 1;
    private const int PageSize = 50;

    private IEnumerable<XForge.Ide.Application.Dto.EntityFieldDto> VisibleFields =>
        _view.Fields.Skip((_fieldPage - 1) * PageSize).Take(PageSize);

    private IEnumerable<XForge.Ide.Application.Dto.EntityKeyDto> VisibleKeys =>
        _view.Keys.Skip((_keyPage - 1) * PageSize).Take(PageSize);

    private Task OnFieldPageChanged(int page)
    {
        _fieldPage = page;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnKeyPageChanged(int page)
    {
        _keyPage = page;
        StateHasChanged();
        return Task.CompletedTask;
    }

    protected override void OnParametersSet()
    {
        // Só adota o parâmetro quando for uma instância nova (mudança de entidade ou
        // reload do pai). Re-renders do pai sem reload preservam a cópia local mais fresca.
        if (!ReferenceEquals(Entity, _lastParam))
        {
            _lastParam = Entity;
            _view = Entity;
            _fieldPage = 1;
            _keyPage = 1;
        }
    }

    // Modal adicionar campo
    private static readonly string[] _clrTypes = ["string", "int", "long", "decimal", "double", "DateTime", "bool", "Guid", "byte[]"];
    private bool _showFieldModal;
    private string _fieldName = string.Empty;
    private string _fieldType = "string";
    private string? _fieldLength;
    private string? _fieldLabel;
    private string? _fieldPicture;
    private bool? _fieldRequired;
    private string? _error;

    // Confirmação de exclusão
    private bool _showDeleteConfirm;
    private string _deleteTitle = "Confirmar exclusão";
    private string? _deleteTargetName;
    private Func<Task>? _deleteAction;

    private Task OpenFieldModalAsync()
    {
        _fieldName = string.Empty;
        _fieldLength = null;
        _fieldLabel = null;
        _fieldPicture = null;
        _fieldRequired = false;
        _error = null;
        _showFieldModal = true;
        return Task.CompletedTask;
    }

    private Task OnFieldModalChanged(bool open)
        {
            _showFieldModal = open;
            return Task.CompletedTask;
        }

    private Task OnFieldTypeChanged(string? value)
    {
        _fieldType = value ?? "string";
        return Task.CompletedTask;
    }

    private Task OnRequiredChanged(bool? value)
    {
        _fieldRequired = value ?? false;
        return Task.CompletedTask;
    }

    private async Task AddFieldAsync()
    {
        if (string.IsNullOrWhiteSpace(_fieldName))
        {
            _error = "Informe o nome do campo.";
            return;
        }

        int? length = int.TryParse(_fieldLength, out var len) ? len : null;

        var result = await Dictionaries.AddFieldAsync(new(
            _view.Id, _fieldName, _fieldType, null, length, null,
            _fieldRequired ?? false, null, _fieldPicture, _fieldLabel, null));

        if (result.IsSuccess)
        {
            _showFieldModal = false;
            _error = null;
            await ReloadViewAsync();
            await NotifyChangedAsync();
            StateHasChanged();
        }
        else
        {
            _error = result.Error;
        }
    }

    private Task AskDeleteFieldAsync(EntityFieldDto f)
    {
        _deleteTitle = "Remover campo";
        _deleteTargetName = f.Name;
        _deleteAction = async () =>
        {
            await Dictionaries.DeleteFieldAsync(f.Id);
            await ReloadViewAsync();
            await NotifyChangedAsync();
            StateHasChanged();
        };
        _showDeleteConfirm = true;
        return Task.CompletedTask;
    }

    private Task AskDeleteKeyAsync(EntityKeyDto k)
    {
        _deleteTitle = "Remover chave";
        _deleteTargetName = k.Name;
        _deleteAction = async () =>
        {
            await Dictionaries.DeleteKeyAsync(k.Id);
            await ReloadViewAsync();
            await NotifyChangedAsync();
            StateHasChanged();
        };
        _showDeleteConfirm = true;
        return Task.CompletedTask;
    }

    private Task OnDeleteConfirmChanged(bool open)
    {
        _showDeleteConfirm = open;
        if (!open)
        {
            _deleteAction = null;
        }
        return Task.CompletedTask;
    }

    private async Task DeleteConfirmedAsync()
    {
        if (_deleteAction is null) return;
        var action = _deleteAction;
        _deleteAction = null;
        await action();
        _showDeleteConfirm = false;
        StateHasChanged();
    }

    private async Task NotifyChangedAsync()
    {
        if (Changed is not null)
        {
            await Changed.Invoke();
        }
    }

    /// <summary>Recarrega a entidade do banco e atualiza a cópia local (refresh imediato).</summary>
    private async Task ReloadViewAsync()
    {
        var fresh = await Dictionaries.GetEntityAsync(_view.Id);
        if (fresh is not null)
        {
            _view = fresh;
            Entity = fresh;
            _fieldPage = 1;
            _keyPage = 1;
        }
    }
}
