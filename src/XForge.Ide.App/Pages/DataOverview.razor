@page "/data"
@rendermode InteractiveServer
@using XForge.Ide.Application.Services
@using XForge.Ide.Application.Dto
@using XForge.Ide.Core.Enums
@using XForge.Ide.App.Components
@inject DictionaryService Dictionaries
@inject IdeUiState Ui
@inject XForge.Ide.Application.Services.ProjectService Projects
@inject NavigationManager Nav

<PageTitle>XForge IDE — Data Designer</PageTitle>

<XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
    <XFTypography Variant="XFTypographyVariant.H1" Weight="XFTypographyWeight.Bold">Designer de Dados</XFTypography>

    @if (Ui.CurrentProject is null)
    {
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
            <ChildContent>
                <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                    Abra um projeto em <b>Projetos</b> para trabalhar no dicionário de dados.
                </XFTypography>
            </ChildContent>
        </XFCard>
    }
    else
    {
        @* ---------------------------------------------------------- Dicionários *@
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Horizontal" Gap="3" AlignItems="XFAlignItems.Center">
                    <XFTypography Variant="XFTypographyVariant.H3" Weight="XFTypographyWeight.Semibold">
                        Dicionários de @Ui.CurrentProject.Name
                    </XFTypography>
                    @* atalhos: criar e editar dicionário (modais) *@
                    <XFButton Text="Adicionar dicionário" Variant="XFButtonVariant.Soft" Color="XFButtonColor.Primary"
                              OnClick="OpenDictModalAsync" />
                    <XFButton Text="Editar dicionário" Variant="XFButtonVariant.Soft" Color="XFButtonColor.Secondary"
                              Disabled="@(_currentDictionary is null)"
                              AriaLabel="Editar dicionário aberto"
                              OnClick="OpenDictEditModalAsync" />
                </XFStack>

                @if (_message is not null)
                {
                    <div role="status" aria-live="polite"
                         class="mt-3 border border-info/30 bg-info/10 text-info-text rounded-md px-4 py-2 text-sm">@_message</div>
                }

                @if (_dictionaries.Count == 0)
                {
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary" Class="mt-3">
                        Nenhum dicionário. Crie um ou importe um banco SQLite em <b>Importar banco</b>.
                    </XFTypography>
                }
                else
                {
                    <XFTable Striped="true" Hoverable="true" Compact="true" Class="mt-3">
                        <XFTableHeader>
                            <XFTableRow>
                                <XFTableCell Header="true">Nome</XFTableCell>
                                <XFTableCell Header="true">Entidades</XFTableCell>
                                <XFTableCell Header="true">Versão</XFTableCell>
                                <XFTableCell Header="true">Ações</XFTableCell>
                            </XFTableRow>
                        </XFTableHeader>
                        <XFTableBody>
                            @foreach (var d in VisibleDictionaries)
                            {
                                <XFTableRow>
                                    <XFTableCell>@d.Name</XFTableCell>
                                    <XFTableCell>@d.EntityCount</XFTableCell>
                                    <XFTableCell>v@(d.Version)</XFTableCell>
                                    <XFTableCell>
                                        <div class="flex gap-2">
                                            <XFButton Text="Abrir" AriaLabel="@($"Abrir dicionário {d.Name}")" Variant="XFButtonVariant.Soft" Color="XFButtonColor.Primary" Size="XFExtendedSize.Sm"
                                                      OnClick="() => OpenDictionaryAsync(d)" />
                                            <XFButton Text="Excluir" AriaLabel="@($"Excluir dicionário {d.Name}")" Variant="XFButtonVariant.Soft" Color="XFButtonColor.Danger" Size="XFExtendedSize.Sm"
                                                      OnClick="() => AskDeleteDictAsync(d)" />
                                        </div>
                                    </XFTableCell>
                                </XFTableRow>
                            }
                        </XFTableBody>
                    </XFTable>

                    <DataPager TotalItems="_dictionaries.Count" Page="_dictionaryPage" PageSize="PageSize"
                               PageChanged="OnDictionaryPageChanged" />
                }
            </ChildContent>
        </XFCard>

        @* ------------------------------------------------------------ Entidades *@
        @if (_currentDictionary is not null)
        {
            <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="3" AlignItems="XFAlignItems.Center">
                        <XFTypography Variant="XFTypographyVariant.H3" Weight="XFTypographyWeight.Semibold">
                            Entidades — @_currentDictionary.Name
                        </XFTypography>
                        <XFButton Text="Nova entidade" Variant="XFButtonVariant.Soft" Color="XFButtonColor.Primary"
                                  OnClick="OpenEntityModalAsync" />
                        @if (_currentEntity is not null)
                        {
                            <XFButton Text="Propriedades" Variant="XFButtonVariant.Soft" Color="XFButtonColor.Secondary" Size="XFExtendedSize.Sm"
                                      AriaLabel="@($"Propriedades da entidade {_currentEntity.Name}")"
                                      OnClick="OpenEntityPropsModalAsync" />
                            <XFButton Text="Excluir" Variant="XFButtonVariant.Soft" Color="XFButtonColor.Danger" Size="XFExtendedSize.Sm"
                                      AriaLabel="@($"Excluir entidade {_currentEntity.Name}")"
                                      OnClick="() => AskDeleteEntityAsync(_currentEntity)" />
                        }
                    </XFStack>

                    <DictionaryWorkspace Entities="_entities" Entity="@_currentEntity"
                                         EntitySelected="OnEntitySelectedAsync"
                                         OnNewEntity="OpenEntityModalAsync"
                                         Changed="OnEntityChangedAsync"
                                         FieldId="_fieldId"
                                         FieldIdChanged="OnFieldSelectedAsync"
                                         TabIndex="_tab"
                                         TabIndexChanged="OnTabChangedAsync"
                                         GlobalFields="_globalFields" />
                </ChildContent>
            </XFCard>
        }

        @* ---------------------------------------------- colunas globais (Derived From) *@
        @if (_currentDictionary is not null)
        {
            <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="3" AlignItems="XFAlignItems.Center">
                        <XFTypography Variant="XFTypographyVariant.H3" Weight="XFTypographyWeight.Semibold">
                            Colunas globais de @_currentDictionary.Name
                        </XFTypography>
                        <XFButton Text="Adicionar coluna global" Variant="XFButtonVariant.Soft" Color="XFButtonColor.Primary"
                                  OnClick="OpenGlobalModalAsync" />
                    </XFStack>

                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary" Class="mt-1">
                        ≈ "Derived From" do Clarion: defina a coluna UMA vez e derive em N tabelas.
                        Alterar o modelo aqui propaga para todos os campos derivados.
                    </XFTypography>

                    @if (_globalFields.Count == 0)
                    {
                        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary" Class="mt-3">
                            Nenhuma coluna global. Crie uma e use "Derivar de" no modal de adicionar coluna.
                        </XFTypography>
                    }
                    else
                    {
                        <XFTable Striped="true" Hoverable="true" Compact="true" Class="mt-3">
                            <XFTableHeader>
                                <XFTableRow>
                                    <XFTableCell Header="true">Nome</XFTableCell>
                                    <XFTableCell Header="true">Tipo</XFTableCell>
                                    <XFTableCell Header="true">Picture</XFTableCell>
                                    <XFTableCell Header="true">Obrig.</XFTableCell>
                                    <XFTableCell Header="true">Ações</XFTableCell>
                                </XFTableRow>
                            </XFTableHeader>
                            <XFTableBody>
                                @foreach (var g in _globalFields)
                                {
                                    <XFTableRow>
                                        <XFTableCell>@g.Name</XFTableCell>
                                        <XFTableCell>@g.ClrType@(g.Length is not null ? "(" + g.Length + ")" : "")</XFTableCell>
                                        <XFTableCell>@(g.Picture ?? "—")</XFTableCell>
                                        <XFTableCell>@(g.Required ? "sim" : "não")</XFTableCell>
                                        <XFTableCell>
                                            <div class="flex gap-2">
                                                <XFButton Text="Editar" AriaLabel="@($"Editar coluna global {g.Name}")" Variant="XFButtonVariant.Soft" Color="XFButtonColor.Secondary" Size="XFExtendedSize.Sm"
                                                          OnClick="() => OpenGlobalEditModalAsync(g)" />
                                                <XFButton Text="Excluir" AriaLabel="@($"Excluir coluna global {g.Name}")" Variant="XFButtonVariant.Soft" Color="XFButtonColor.Danger" Size="XFExtendedSize.Sm"
                                                          OnClick="() => AskDeleteGlobalAsync(g)" />
                                            </div>
                                        </XFTableCell>
                                    </XFTableRow>
                                }
                            </XFTableBody>
                        </XFTable>
                    }
                </ChildContent>
            </XFCard>
        }

        @* -------------------------------------------------- Relacionamentos *@
        @if (_currentDictionary is not null && _entities.Count > 1)
        {
            <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="3" AlignItems="XFAlignItems.Center">
                        <XFTypography Variant="XFTypographyVariant.H3" Weight="XFTypographyWeight.Semibold">
                            Relacionamentos de @_currentDictionary.Name
                        </XFTypography>
                        <XFButton Text="Nova relação" Variant="XFButtonVariant.Soft" Color="XFButtonColor.Primary"
                                  OnClick="OpenRelationModalAsync" />
                    </XFStack>

                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary" Class="mt-1">
                        Definem como as entidades se ligam (1:N, N:1, 1:1, N:N). Base para master-detail,
                        chaves estrangeiras e navegações do EF Core.
                    </XFTypography>

                    <XFTable Striped="true" Hoverable="true" Compact="true" Class="mt-3">
                        <XFTableHeader>
                            <XFTableRow>
                                <XFTableCell Header="true">Origem</XFTableCell>
                                <XFTableCell Header="true">Tipo</XFTableCell>
                                <XFTableCell Header="true">Destino</XFTableCell>
                                <XFTableCell Header="true"></XFTableCell>
                            </XFTableRow>
                        </XFTableHeader>
                        <XFTableBody>
                            @if (_relations.Count == 0)
                            {
                                <XFTableRow>
                                    <XFTableCell ColumnSpan="4">
                                        <span class="text-text-muted text-sm">Nenhum relacionamento definido.</span>
                                    </XFTableCell>
                                </XFTableRow>
                            }
                            @foreach (var r in VisibleRelations)
                            {
                                <XFTableRow>
                                    <XFTableCell>@r.FromEntity</XFTableCell>
                                    <XFTableCell>
                                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@r.Kind" />
                                    </XFTableCell>
                                    <XFTableCell>@r.ToEntity</XFTableCell>
                                    <XFTableCell>
                                        <XFButton Text="Excluir" AriaLabel="@($"Excluir relação {r.FromEntity} para {r.ToEntity}")" Variant="XFButtonVariant.Soft" Color="XFButtonColor.Danger" Size="XFExtendedSize.Sm"
                                                  OnClick="() => AskDeleteRelationAsync(r)" />
                                    </XFTableCell>
                                </XFTableRow>
                            }
                        </XFTableBody>
                    </XFTable>

                    <DataPager TotalItems="_relations.Count" Page="_relationPage" PageSize="PageSize"
                               PageChanged="OnRelationPageChanged" />
                </ChildContent>
            </XFCard>
        }

    }
</XFStack>

@* ======================================================== Modal: nova relação *@
<Modal Open="@_showRelationModal" OpenChanged="OnRelationModalChanged"
       Title="Nova relação" Description="Ligue duas entidades do dicionário."
       ConfirmText="Criar relação" ConfirmAction="CreateRelationAsync">
    <XFCombobox TItem="string" TValue="string" Label="Entidade origem *" Placeholder="Selecione"
                Items="@_entityNames" Value="@_relationFrom"
                ValueChanged="(string? v) => _relationFrom = v ?? string.Empty" />
    <XFCombobox TItem="string" TValue="string" Label="Entidade destino *" Placeholder="Selecione"
                Items="@_entityNames" Value="@_relationTo"
                ValueChanged="(string? v) => _relationTo = v ?? string.Empty" />
    <XFCombobox TItem="string" TValue="string" Label="Tipo *"
                Items="@_relationKinds"
                Value="@_relationKind" ValueChanged="OnRelationKindChanged" />
</Modal>

@* =========================================================== Modal: novo dicionário *@
<Modal Open="@_showDictModal" OpenChanged="OnDictModalChanged"
       Title="Novo dicionário" Description="Agrupa as entidades do projeto (sucessor do .DCT do Clarion)"
       ConfirmText="Criar dicionário" ConfirmAction="CreateDictAsync">
    <XFTextInput Label="Nome *" Placeholder="Principal"
                 Value="@_dictName" ValueChanged="(string v) => _dictName = v ?? string.Empty" />
</Modal>

@* ==================================================== Modal: coluna global (Derived From) *@
<Modal Open="@_showGlobalModal" OpenChanged="OnGlobalModalChanged"
       Title="@(_editingGlobalId is null ? "Nova coluna global" : "Editar coluna global")"
       Description="Alterar o modelo propaga para todos os campos derivados dele."
       ConfirmText="Salvar" ConfirmAction="SaveGlobalAsync">
    <div class="grid gap-4 md:grid-cols-2">
        <XFTextInput Label="Nome *" Placeholder="NomeCliente"
                     Value="@_globalName" ValueChanged="(string v) => _globalName = v ?? string.Empty" />
        <XFCombobox TItem="string" TValue="string" Label="Tipo *" Placeholder="Selecione"
                    Items="@FieldRules.ClrTypes" TextSelector="@(t => t)" ValueSelector="@(t => t)"
                    Value="@_globalClrType" ValueChanged='(string? v) => _globalClrType = v ?? "string"' />
        <XFTextInput Label="Picture (opcional)" Placeholder="@@s40"
                     Value="@_globalPicture" ValueChanged="(string v) => _globalPicture = v" />
        <XFTextInput Label="Rótulo (opcional)" Placeholder="Nome do cliente"
                     Value="@_globalLabel" ValueChanged="(string? v) => _globalLabel = v" />
        <XFTextInput Label="Caracteres (opcional)" Placeholder="50"
                     Value="@_globalLength" ValueChanged="(string v) => _globalLength = v" />
        <XFTextInput Label="Valor padrão (opcional)" Placeholder="(nenhum)"
                     Value="@_globalDefault" ValueChanged="(string? v) => _globalDefault = v" />
        <XFTextInput Label="Descrição (opcional)" Placeholder="Documentação do modelo"
                     Value="@_globalDescription" ValueChanged="(string? v) => _globalDescription = v" />
        <XFCheckbox Label="Obrigatório" Value="@_globalRequired" ValueChanged="(bool? v) => _globalRequired = v ?? false" />
    </div>
    @if (_globalError is not null)
    {
        <div role="alert" class="ide-dict__status ide-dict__status--error">@_globalError</div>
    }
</Modal>

@* ====================================================== Modal: editar dicionário *@
<Modal Open="@_showDictEditModal" OpenChanged="OnDictEditModalChanged"
       Title="Editar dicionário" Description="Renomeia o dicionário aberto (≈ renomear o .DCT no Clarion)."
       ConfirmText="Salvar" ConfirmAction="RenameDictAsync">
    <XFTextInput Label="Nome *" Placeholder="Principal"
                 Value="@_editDictName" ValueChanged="(string v) => _editDictName = v ?? string.Empty" />
</Modal>

@* ============================================================= Modal: nova entidade *@
<Modal Open="@_showEntityModal" OpenChanged="OnEntityModalChanged"
       Title="Nova entidade" Description="A chave primária Id (Guid) é criada automaticamente"
       ConfirmText="Criar entidade" ConfirmAction="CreateEntityAsync">
    <div class="grid gap-4 md:grid-cols-2">
        <XFTextInput Label="Nome da entidade *" Placeholder="Customer"
                     Value="@_entityName" ValueChanged="(string v) => _entityName = v ?? string.Empty" />
        <XFTextInput Label="Tabela (opcional)" Placeholder="Customers"
                     Value="@_entityTable" ValueChanged="(string v) => _entityTable = v ?? string.Empty" />
        <XFTextInput Label="Prefixo (estilo Clarion, opcional)" Placeholder="CUS"
                     Value="@_entityPrefix" ValueChanged="(string v) => _entityPrefix = v" />
    </div>
</Modal>

@* ================================================== Modal: propriedades da entidade *@
<Modal Open="@_showPropsModal" OpenChanged="OnEntityPropsModalChanged"
       Title="Propriedades da entidade" Description="Nome, tabela física e prefixo (≈ Table Properties do Clarion)."
       ConfirmText="Salvar" ConfirmAction="SaveEntityPropsAsync">
    <div class="grid gap-4 md:grid-cols-2">
        <XFTextInput Label="Nome da entidade *" Placeholder="Customer"
                     Value="@_propsName" ValueChanged="(string v) => _propsName = v ?? string.Empty" />
        <XFTextInput Label="Tabela no banco *" Placeholder="Customers"
                     Value="@_propsTable" ValueChanged="(string v) => _propsTable = v ?? string.Empty" />
        <XFTextInput Label="Prefixo (opcional)" Placeholder="CUS"
                     Value="@_propsPrefix" ValueChanged="(string? v) => _propsPrefix = v" />
        <XFTextInput Label="Nome externo SQL (opcional)" Placeholder="cus_customers"
                     Value="@_propsExternal" ValueChanged="(string? v) => _propsExternal = v" />
    </div>
</Modal>

@* ====================================================== Modal: confirmar exclusões *@
<ConfirmDialog Open="@_showDeleteConfirm" OpenChanged="OnDeleteConfirmChanged"
               Title="@_deleteTitle"
               ConfirmMessage="@_deleteMessage"
               TargetName="@_deleteTargetName"
               ConfirmText="Excluir"
               OnConfirm="DeleteConfirmedAsync" />

@code {
    private IReadOnlyList<DictionaryDto> _dictionaries = Array.Empty<DictionaryDto>();
    private DictionaryDto? _currentDictionary;
    private IReadOnlyList<EntityDto> _entities = Array.Empty<EntityDto>();
    private EntityDto? _currentEntity;
    private IReadOnlyList<EntityRelationDto> _relations = Array.Empty<EntityRelationDto>();
    private IReadOnlyList<GlobalFieldDto> _globalFields = Array.Empty<GlobalFieldDto>();
    private int _dictionaryPage = 1;
    private int _relationPage = 1;
    private const int PageSize = 20;

    private IEnumerable<DictionaryDto> VisibleDictionaries =>
        _dictionaries.Skip((_dictionaryPage - 1) * PageSize).Take(PageSize);

    private IEnumerable<EntityRelationDto> VisibleRelations =>
        _relations.Skip((_relationPage - 1) * PageSize).Take(PageSize);

    private Task OnDictionaryPageChanged(int page)
    {
        _dictionaryPage = page;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnRelationPageChanged(int page)
    {
        _relationPage = page;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private string? _message;
    private List<string> _entityNames = new();

    // Modal relação
    private bool _showRelationModal;
    private string _relationFrom = string.Empty;
    private string _relationTo = string.Empty;
    private string _relationKind = "OneToMany";
    private static readonly string[] _relationKinds = { "OneToMany", "ManyToOne", "OneToOne", "ManyToMany" };

    private void OnRelationKindChanged(string? value)
        => _relationKind = value ?? "OneToMany";

    private Task OpenRelationModalAsync()
    {
        _entityNames = _entities.Select(e => e.Name).OrderBy(n => n).ToList();
        _relationFrom = _entityNames.FirstOrDefault() ?? string.Empty;
        _relationTo = _entityNames.Skip(1).FirstOrDefault() ?? string.Empty;
        _showRelationModal = true;
        return Task.CompletedTask;
    }

    private Task OnRelationModalChanged(bool open)
    {
        _showRelationModal = open;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task CreateRelationAsync()
    {
        if (_currentDictionary is null || _relationFrom.Length == 0 || _relationTo.Length == 0)
        {
            _message = "Selecione as entidades de origem e destino.";
            StateHasChanged();
            return;
        }
        if (string.Equals(_relationFrom, _relationTo, StringComparison.OrdinalIgnoreCase))
        {
            _message = "A relação precisa ligar duas entidades diferentes.";
            StateHasChanged();
            return;
        }

        var from = _entities.FirstOrDefault(e => e.Name == _relationFrom);
        var to = _entities.FirstOrDefault(e => e.Name == _relationTo);
        if (from is null || to is null)
        {
            _message = "Selecione entidades válidas do dicionário.";
            StateHasChanged();
            return;
        }

        if (!Enum.TryParse<EntityRelationKind>(_relationKind, out var kind))
        {
            kind = EntityRelationKind.OneToMany;
        }

        var result = await Dictionaries.AddRelationAsync(new CreateRelationRequest(
            _currentDictionary.Id, from.Id, to.Id, kind, "[]"));
        _message = result.IsSuccess ? "Relação criada." : result.Error ?? "Falha ao criar relação.";
        _showRelationModal = false;
        await LoadRelationsAsync();
        await ReloadDictionariesAsync();
        StateHasChanged();
    }

    private async Task LoadRelationsAsync()
    {
        if (_currentDictionary is null)
        {
            _relations = Array.Empty<EntityRelationDto>();
            return;
        }
        _relations = await Dictionaries.ListRelationsAsync(_currentDictionary.Id);
        _relationPage = 1;
    }

    private async Task AskDeleteRelationAsync(EntityRelationDto r)
    {
        _deleteTitle = "Excluir relação";
        _deleteMessage = $"A ligação entre {r.FromEntity} e {r.ToEntity} será removida.";
        _deleteTargetName = $"{r.FromEntity} → {r.ToEntity}";
        _deleteAction = async () =>
        {
            await Dictionaries.DeleteRelationAsync(r.Id);
            await LoadRelationsAsync();
        await ReloadDictionariesAsync();
        };
        _showDeleteConfirm = true;
        StateHasChanged();
    }

    // Modal dicionário
    private bool _showDictModal;
    private string _dictName = string.Empty;

    // Modal editar dicionário (rename)
    private bool _showDictEditModal;
    private string _editDictName = string.Empty;

    // Modal entidade
    private bool _showEntityModal;
    private string _entityName = string.Empty;
    private string _entityTable = string.Empty;
    private string? _entityPrefix;

    // Modal propriedades da entidade (≈ Table Properties)
    private bool _showPropsModal;
    private string _propsName = string.Empty;
    private string _propsTable = string.Empty;
    private string? _propsPrefix;
    private string? _propsExternal;

    // Confirmação de exclusão
    private bool _showDeleteConfirm;
    private string _deleteTitle = "Confirmar exclusão";
    private string _deleteMessage = string.Empty;
    private string? _deleteTargetName;
    private Func<Task>? _deleteAction;

    private Guid? _lastProjectId;

    protected override async Task OnInitializedAsync()
    {
        Ui.Changed += OnUiStateChanged;
        _lastProjectId = Ui.CurrentProject?.Id;
        var restored = await ProjectRestorer.TryRestoreAsync(Ui, id => Projects.GetAsync(id));
        if (restored || Ui.CurrentProject is not null)
        {
            await ReloadDictionariesAsync();
        }
    }

    private async void OnUiStateChanged()
    {
        var currentId = Ui.CurrentProject?.Id;
        if (currentId == _lastProjectId)
        {
            return;
        }
        _lastProjectId = currentId;
        await ReloadDictionariesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReloadDictionariesAsync()
    {
        if (Ui.CurrentProject is null) return;
        _dictionaries = await Dictionaries.ListByProjectAsync(Ui.CurrentProject.Id);
        _dictionaryPage = 1;
        if (_currentDictionary is not null)
        {
            _currentDictionary = _dictionaries.FirstOrDefault(d => d.Id == _currentDictionary.Id) ?? _currentDictionary;
        }
    }

    // ------------------------------------------------------------- Dicionários

    private Task OpenDictModalAsync()
    {
        _dictName = string.Empty;
        _showDictModal = true;
        return Task.CompletedTask;
    }

    private Task OnDictModalChanged(bool open)
        {
            _showDictModal = open;
            return Task.CompletedTask;
        }

    private Task OpenDictEditModalAsync()
    {
        if (_currentDictionary is null)
        {
            return Task.CompletedTask;
        }
        _editDictName = _currentDictionary.Name;
        _showDictEditModal = true;
        return Task.CompletedTask;
    }

    private Task OnDictEditModalChanged(bool open)
    {
        _showDictEditModal = open;
        return Task.CompletedTask;
    }

    private async Task RenameDictAsync()
    {
        if (_currentDictionary is null)
        {
            return;
        }
        if (string.IsNullOrWhiteSpace(_editDictName))
        {
            _message = "Informe o nome do dicionário.";
            StateHasChanged();
            return;
        }

        var result = await Dictionaries.RenameAsync(new(_currentDictionary.Id, _editDictName.Trim()));
        if (result.IsSuccess)
        {
            _showDictEditModal = false;
            _message = $"Dicionário renomeado para '{result.Value.Name}'.";
            await ReloadDictionariesAsync();
            // o shell escuta Ui.Changed e recarrega a sidebar (novo rótulo)
            Ui.SetStatus($"Dicionário: {result.Value.Name}");
        }
        else
        {
            _message = result.Error;
        }
        StateHasChanged();
    }

    private async Task CreateDictAsync()
    {
        if (Ui.CurrentProject is null) return;
        if (string.IsNullOrWhiteSpace(_dictName))
        {
            _message = "Informe o nome do dicionário.";
            StateHasChanged();
            return;
        }

        var result = await Dictionaries.CreateAsync(new(Ui.CurrentProject.Id, _dictName.Trim()));
        if (result.IsSuccess)
        {
            _showDictModal = false;
            await ReloadDictionariesAsync();
            await OpenDictionaryAsync(result.Value);
            _message = $"Dicionário '{result.Value.Name}' criado.";
        }
        else
        {
            _message = result.Error;
        }
        StateHasChanged();
    }

    /// <summary>
    /// Abre o dicionário. <paramref name="syncUrl"/> é false quando a chamada
    /// vem da própria URL (restauração de F5) — navegar ali reescreveria a URL
    /// com o estado ainda vazio e dispararia outro OnParametersSetAsync.
    /// </summary>
    private async Task OpenDictionaryAsync(DictionaryDto d, bool syncUrl = true)
    {
        _currentDictionary = d;
        _currentEntity = null;
        _fieldId = null;
        _tab = 0;
        _entities = await Dictionaries.ListEntitiesAsync(d.Id);
        _globalFields = await Dictionaries.ListGlobalFieldsAsync(d.Id);
        await LoadRelationsAsync();
        await ReloadDictionariesAsync();
        if (syncUrl)
        {
            await SyncUrlAsync();
        }
    }

    /// <summary>Dicionário aberto via query (?dict=&lt;id&gt;) — sustenta a sidebar e o F5.</summary>
    [SupplyParameterFromQuery(Name = "dict")]
    public string? DictQuery { get; set; }

    /// <summary>
    /// Sidebar navega para /data?dict=&lt;id&gt;: abre o dicionário no workspace,
    /// sem sessão/tela separada por dicionário. O parâmetro supply-from-query
    /// é o que faz o Router re-renderizar a página na troca só de query.
    /// A URL também carrega a tabela (?entity=), a coluna (?field=) e a aba
    /// (?tab=) do Property Sheet — o F5 devolve o workspace inteiro.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        var entityId = Guid.TryParse(query["entity"], out var parsedEntity) ? parsedEntity : (Guid?)null;
        var fieldId = Guid.TryParse(query["field"], out var parsedField) ? parsedField : (Guid?)null;
        var tab = TabFromName(query["tab"]);

        if (Guid.TryParse(DictQuery, out var dictId) && _currentDictionary?.Id != dictId)
        {
            var target = _dictionaries.FirstOrDefault(d => d.Id == dictId);
            if (target is null)
            {
                await ReloadDictionariesAsync();
                target = _dictionaries.FirstOrDefault(d => d.Id == dictId);
            }

            if (target is not null)
            {
                // sem sync: a URL já é a fonte da verdade nesta restauração
                await OpenDictionaryAsync(target, syncUrl: false);
            }
            else
            {
                _message = "Dicionário não encontrado.";
            }
        }

        // aplica o resto da URL DEPOIS do reset do OpenDictionaryAsync
        _fieldId = fieldId;
        _tab = tab;

        // tabela da URL: GetEntityAsync traz campos/chaves para o Property Sheet
        if (_currentDictionary is not null && entityId is Guid id && _currentEntity?.Id != id)
        {
            var fresh = await Dictionaries.GetEntityAsync(id);
            if (fresh is not null)
            {
                _currentEntity = fresh;
            }
        }

        StateHasChanged();
        await base.OnParametersSetAsync();
    }

    // ------------------------------------------------- URL: espelho do workspace

    private Guid? _fieldId;
    private int _tab;

    private static string TabName(int tab) => tab switch
    {
        1 => "picture",
        2 => "advanced",
        _ => "general"
    };

    private static int TabFromName(string? name) => name?.Trim().ToLowerInvariant() switch
    {
        "picture" => 1,
        "advanced" => 2,
        _ => 0
    };

    /// <summary>URL que espelha o estado atual do workspace (dict/entity/field/tab).</summary>
    private string CurrentDataUrl()
    {
        var parts = new List<string>();
        if (_currentDictionary is not null)
        {
            parts.Add("dict=" + _currentDictionary.Id);
        }
        if (_currentEntity is not null)
        {
            parts.Add("entity=" + _currentEntity.Id);
        }
        if (_currentEntity is not null && _fieldId is Guid fieldId)
        {
            parts.Add("field=" + fieldId);
            if (_tab != 0)
            {
                parts.Add("tab=" + TabName(_tab));
            }
        }
        return parts.Count == 0 ? "/data" : "/data?" + string.Join("&", parts);
    }

    /// <summary>
    /// Grava a URL somente quando ela difere do estado atual (evita laço com
    /// OnParametersSetAsync). replace: true não polui o histórico do navegador.
    /// </summary>
    private Task SyncUrlAsync()
    {
        var url = CurrentDataUrl();
        if (!string.Equals(new Uri(Nav.Uri).PathAndQuery, url, StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo(url, replace: true);
        }
        return Task.CompletedTask;
    }

    private async Task OnEntitySelectedAsync(EntityDto e)
    {
        _currentEntity = await Dictionaries.GetEntityAsync(e.Id);
        _fieldId = null;
        _tab = 0;
        await SyncUrlAsync();
        StateHasChanged();
    }

    private async Task OnFieldSelectedAsync(Guid? fieldId)
    {
        _fieldId = fieldId;
        // trocar de coluna volta a aba do Property Sheet para "Geral"
        _tab = 0;
        await SyncUrlAsync();
    }

    private async Task OnTabChangedAsync(int tab)
    {
        _tab = tab;
        await SyncUrlAsync();
    }

    private Task AskDeleteDictAsync(DictionaryDto d)
    {
        _deleteTitle = "Excluir dicionário";
        _deleteMessage = "Todas as entidades, campos e chaves deste dicionário serão removidos.";
        _deleteTargetName = d.Name;
        _deleteAction = async () =>
        {
            await Dictionaries.DeleteAsync(d.Id);
            if (_currentDictionary?.Id == d.Id)
            {
                _currentDictionary = null;
                _entities = Array.Empty<EntityDto>();
                _currentEntity = null;
            }
            await ReloadDictionariesAsync();
            _message = $"Dicionário '{d.Name}' excluído.";
            // remove o ?dict= da URL — nenhum dicionário fica aberto
            if (System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["dict"] is not null)
            {
                Nav.NavigateTo("/data");
            }
        };
        _showDeleteConfirm = true;
        return Task.CompletedTask;
    }

    // -------------------------------------------- colunas globais (Derived From)

    private bool _showGlobalModal;
    private Guid? _editingGlobalId;
    private string _globalName = string.Empty;
    private string _globalClrType = "string";
    private string? _globalPicture;
    private string? _globalLabel;
    private string _globalLength = string.Empty;
    private string? _globalDefault;
    private string? _globalDescription;
    private bool _globalRequired;
    private string? _globalError;

    private Task OpenGlobalModalAsync()
    {
        _editingGlobalId = null;
        _globalName = string.Empty;
        _globalClrType = "string";
        _globalPicture = null;
        _globalLabel = null;
        _globalLength = string.Empty;
        _globalDefault = null;
        _globalDescription = null;
        _globalRequired = false;
        _globalError = null;
        _showGlobalModal = true;
        return Task.CompletedTask;
    }

    private Task OpenGlobalEditModalAsync(GlobalFieldDto g)
    {
        _editingGlobalId = g.Id;
        _globalName = g.Name;
        _globalClrType = g.ClrType;
        _globalPicture = g.Picture;
        _globalLabel = g.Label;
        _globalLength = g.Length?.ToString() ?? string.Empty;
        _globalDefault = g.Default;
        _globalDescription = g.Description;
        _globalRequired = g.Required;
        _globalError = null;
        _showGlobalModal = true;
        return Task.CompletedTask;
    }

    private Task OnGlobalModalChanged(bool open)
    {
        _showGlobalModal = open;
        return Task.CompletedTask;
    }

    private async Task SaveGlobalAsync()
    {
        if (_currentDictionary is null)
        {
            return;
        }
        if (string.IsNullOrWhiteSpace(_globalName))
        {
            _globalError = "Informe o nome da coluna global.";
            StateHasChanged();
            return;
        }

        var pictureError = FieldRules.ValidatePicture(_globalPicture);
        if (pictureError is not null)
        {
            _globalError = pictureError;
            StateHasChanged();
            return;
        }

        var length = FieldRules.TypeAcceptsLength(_globalClrType)
            ? FieldRules.ParseOptionalInt(_globalLength) ?? FieldRules.DefaultStringLength
            : (int?)null;

        if (_editingGlobalId is Guid id)
        {
            var result = await Dictionaries.UpdateGlobalFieldAsync(new(
                id, _globalName.Trim(), _globalClrType, length, _globalPicture, _globalLabel,
                _globalDefault, _globalRequired, _globalDescription));
            if (!result.IsSuccess)
            {
                _globalError = result.Error;
                StateHasChanged();
                return;
            }
            _message = $"Coluna global '{result.Value.Name}' atualizada (propagada para os campos derivados).";
        }
        else
        {
            var result = await Dictionaries.AddGlobalFieldAsync(new(
                _currentDictionary.Id, _globalName.Trim(), _globalClrType, length, _globalPicture,
                _globalLabel, _globalDefault, _globalRequired, _globalDescription));
            if (!result.IsSuccess)
            {
                _globalError = result.Error;
                StateHasChanged();
                return;
            }
            _message = $"Coluna global '{result.Value.Name}' criada.";
        }

        _showGlobalModal = false;
        _globalFields = await Dictionaries.ListGlobalFieldsAsync(_currentDictionary.Id);
        // recarrega a entidade aberta: a propagação renomeou campos derivados
        await OnEntityChangedAsync();
    }

    private Task AskDeleteGlobalAsync(GlobalFieldDto g)
    {
        _deleteTitle = "Excluir coluna global";
        _deleteMessage = "Os campos derivados permanecem nas entidades (apenas perdem o vínculo com o modelo).";
        _deleteTargetName = g.Name;
        _deleteAction = async () =>
        {
            await Dictionaries.DeleteGlobalFieldAsync(g.Id);
            if (_currentDictionary is not null)
            {
                _globalFields = await Dictionaries.ListGlobalFieldsAsync(_currentDictionary.Id);
            }
            _message = $"Coluna global '{g.Name}' excluída.";
            await OnEntityChangedAsync();
        };
        _showDeleteConfirm = true;
        return Task.CompletedTask;
    }

    // --------------------------------------------------------------- Entidades

    private Task OpenEntityModalAsync()
    {
        _entityName = string.Empty;
        _entityTable = string.Empty;
        _entityPrefix = null;
        _showEntityModal = true;
        return Task.CompletedTask;
    }

    private Task OnEntityModalChanged(bool open)
        {
            _showEntityModal = open;
            return Task.CompletedTask;
        }

    private async Task ReloadEntitiesAsync()
    {
        if (_currentDictionary is null)
        {
            return;
        }
        _entities = await Dictionaries.ListEntitiesAsync(_currentDictionary.Id);
        if (_currentEntity is not null)
        {
            _currentEntity = await Dictionaries.GetEntityAsync(_currentEntity.Id);
        }
    }

    private async Task CreateEntityAsync()
    {
        if (_currentDictionary is null) return;
        if (string.IsNullOrWhiteSpace(_entityName))
        {
            _message = "Informe o nome da entidade.";
            StateHasChanged();
            return;
        }

        var result = await Dictionaries.AddEntityAsync(new(
            _currentDictionary.Id, _entityName.Trim(), _entityTable.Trim(),
            "Sqlite", string.IsNullOrWhiteSpace(_entityPrefix) ? null : _entityPrefix.Trim(), null));
        if (result.IsSuccess)
        {
            _showEntityModal = false;
            _entities = await Dictionaries.ListEntitiesAsync(_currentDictionary.Id);
            _currentEntity = await Dictionaries.GetEntityAsync(result.Value.Id);
            _fieldId = null;
            _tab = 0;
        await LoadRelationsAsync();
        await ReloadDictionariesAsync();
            await SyncUrlAsync();
            _message = $"Entidade '{result.Value.Name}' criada (com chave primária Id).";
        }
        else
        {
            _message = result.Error;
        }
    }

    /// <summary>Abre as propriedades da entidade selecionada (≈ Table Properties).</summary>
    private Task OpenEntityPropsModalAsync()
    {
        if (_currentEntity is null)
        {
            return Task.CompletedTask;
        }
        _propsName = _currentEntity.Name;
        _propsTable = _currentEntity.TableName;
        _propsPrefix = _currentEntity.Prefix;
        _propsExternal = _currentEntity.ExternalName;
        _showPropsModal = true;
        return Task.CompletedTask;
    }

    private Task OnEntityPropsModalChanged(bool open)
    {
        _showPropsModal = open;
        return Task.CompletedTask;
    }

    private async Task SaveEntityPropsAsync()
    {
        if (_currentEntity is null)
        {
            return;
        }
        if (string.IsNullOrWhiteSpace(_propsName) || string.IsNullOrWhiteSpace(_propsTable))
        {
            _message = "Informe o nome da entidade e o nome da tabela.";
            return;
        }

        var result = await Dictionaries.UpdateEntityAsync(new(
            _currentEntity.Id, _propsName.Trim(), _propsTable.Trim(), _currentEntity.Provider, _propsPrefix, _propsExternal));
        if (result.IsSuccess)
        {
            _showPropsModal = false;
            _message = $"Entidade '{result.Value.Name}' atualizada.";
            await ReloadEntitiesAsync();
        }
        else
        {
            _message = result.Error;
        }
        StateHasChanged();
    }

    private Task AskDeleteEntityAsync(EntityDto e)
    {
        _deleteTitle = "Excluir entidade";
        _deleteMessage = "A entidade e todos os seus campos serão removidos do dicionário.";
        _deleteTargetName = e.Name;
        _deleteAction = async () =>
        {
            await Dictionaries.DeleteEntityAsync(e.Id);
            if (_currentEntity?.Id == e.Id) _currentEntity = null;
            if (_currentDictionary is not null)
            {
                _entities = await Dictionaries.ListEntitiesAsync(_currentDictionary.Id);
        await LoadRelationsAsync();
        await ReloadDictionariesAsync();
            }
            _message = $"Entidade '{e.Name}' excluída.";
            // URL deixa de apontar para a entidade excluída
            _fieldId = null;
            _tab = 0;
            await SyncUrlAsync();
        };
        _showDeleteConfirm = true;
        return Task.CompletedTask;
    }

    // ------------------------------------------------------------- Confirmação

    private Task OnDeleteConfirmChanged(bool open)
    {
        _showDeleteConfirm = open;
        if (!open)
        {
            _deleteAction = null;
        }
        return Task.CompletedTask;
    }

    private async Task DeleteConfirmedAsync()
    {
        if (_deleteAction is null) return;
        var action = _deleteAction;
        _deleteAction = null;
        await action();
    }

    private async Task OnEntityChangedAsync()
    {
        if (_currentEntity is not null)
        {
            _currentEntity = await Dictionaries.GetEntityAsync(_currentEntity.Id);
            if (_currentDictionary is not null)
            {
                _entities = await Dictionaries.ListEntitiesAsync(_currentDictionary.Id);
        await LoadRelationsAsync();
        await ReloadDictionariesAsync();
            }
            StateHasChanged();
        }
    }
}
