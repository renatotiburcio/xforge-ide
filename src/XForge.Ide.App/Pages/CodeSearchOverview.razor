    private string Rel(string path) =>
        Ui.CurrentProject is { } p && path.StartsWith(p.Path, StringComparison.OrdinalIgnoreCase)
            ? path[p.Path.Length..].TrimStart(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)
            : path;

    /// <summary>
    /// Prévia da linha com TODAS as ocorrências do termo destacadas
    /// (o serviço devolve os intervalos da mesma linha).
    /// </summary>
    private static string Highlight(SearchMatch match)
    {
        var text = match.LineText;
        if (text.Length == 0)
        {
            return string.Empty;
        }

        var spans = match.LineSpans is { Count: > 0 }
            ? match.LineSpans
                .Where(s => s.Start >= 0 && s.Start < text.Length)
                .OrderBy(s => s.Start)
                .ToArray()
            : new[] { new SearchMatchSpan(Math.Clamp(match.Column - 1, 0, text.Length - 1), 1) };

        var sb = new StringBuilder(text.Length + 24);
        var position = 0;
        foreach (var span in spans)
        {
            if (span.Start < position)
            {
                continue; // ocorrência sobreposta
            }
            sb.Append(Enc(text[position..span.Start]));
            var end = Math.Min(text.Length, span.Start + Math.Max(1, span.Length));
            sb.Append("<mark class=\"ide-sx__mark\">").Append(Enc(text[span.Start..end])).Append("</mark>");
            position = end;
        }
        sb.Append(Enc(text[position..]));
        return sb.ToString();
    }

    private static string Enc(string value) => System.Net.WebUtility.HtmlEncode(value);

