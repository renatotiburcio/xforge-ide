        await Task.CompletedTask;
    }

    /// <summary>Uma busca do histórico (chave única = termo + filtros).</summary>
    private sealed class HistoryEntry
    {
        [JsonPropertyName("term")]
        public string Term { get; set; } = string.Empty;

        [JsonPropertyName("include")]
        public string? Include { get; set; }

        [JsonPropertyName("exclude")]
        public string? Exclude { get; set; }

        [JsonPropertyName("regex")]
        public bool Regex { get; set; }

        [JsonPropertyName("caseSensitive")]
        public bool CaseSensitive { get; set; }

        [JsonPropertyName("wholeWord")]
        public bool WholeWord { get; set; }

        public string Key => string.Join('|', Term, Include, Exclude, Regex, CaseSensitive, WholeWord);

        public string FilterLabel
        {
            get
            {
                var flags = new List<string>();
                if (Regex)
                {
                    flags.Add("regex");
                }
                if (CaseSensitive)
                {
                    flags.Add("diferencia maiúsc.");
                }
                if (WholeWord)
                {
                    flags.Add("palavra inteira");
                }
                if (!string.IsNullOrWhiteSpace(Include))
                {
                    flags.Add("inclui " + Include);
                }
                if (!string.IsNullOrWhiteSpace(Exclude))
                {
                    flags.Add("exclui " + Exclude);
                }
                return flags.Count == 0 ? Term : $"{Term} — {string.Join(", ", flags)}";
            }
        }
    }
