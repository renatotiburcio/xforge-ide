    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadHistoryAsync();
            await RestoreFilterSnapshotAsync();
        }
    }

    /// <summary>Devolve o último filtro de busca (F5 não perde o que estava pesquisando).</summary>
    private async Task RestoreFilterSnapshotAsync()
    {
        // O shell restaura o projeto no primeiro render desta página pode rodar
        // antes: sem o projeto a chave do snapshot ficaria "global" e não acharia
        // nada. Espera o projeto chegar (no máx. ~2s).
        for (var tentativa = 0; tentativa < 20 && Ui.CurrentProject is null; tentativa++)
        {
            await Task.Delay(100);
        }

        if (Ui.CurrentProject is null)
        {
            return;
        }

        var snapshot = await Snapshots.RestoreAsync<SearchFilterSnapshot>(
            "/code/search", Ui.CurrentProject.Id);
        if (snapshot is null)
        {
            return;
        }

        _term = snapshot.Term;
        _include = snapshot.Include;
        _exclude = snapshot.Exclude;
        _replacement = snapshot.Replacement;
        _caseSensitive = snapshot.CaseSensitive;
        _wholeWord = snapshot.WholeWord;
        _regex = snapshot.Regex;
        _showReplace = !string.IsNullOrEmpty(_replacement);

        if (_term.Length > 0 && Ui.CurrentProject is not null)
        {
            await RunSearchAsync();
        }
        StateHasChanged();
    }

    private void SaveFilterSnapshot()
        => Snapshots.Save("/code/search", Ui.CurrentProject?.Id,
            new SearchFilterSnapshot(_term, _include, _exclude, _replacement,
                _caseSensitive, _wholeWord, _regex));

    // ------------------------------------------------------------ substituição

    private Task ToggleReplaceAsync()
    {
        _showReplace = !_showReplace;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task AskReplaceFileAsync(SearchFileResult file)
    {
        var count = await SearchService.CountInFileAsync(file.FilePath, Options);
        if (count <= 0)
        {
            _error = "Nenhuma ocorrência substituível neste arquivo.";
            StateHasChanged();
            return;
        }

        Confirm("Substituir neste arquivo",
            $"{count} {(count == 1 ? "ocorrência" : "ocorrências")} de \"{_term}\" serão alteradas{EmptyNote}.",
            file.FilePath,
            "Substituir",
            () => ReplaceInFileAsync(file));
    }

    private async Task AskReplaceAllAsync()
    {
        if (_results.Count == 0)
        {
            return;
        }

        var options = Options;
        var total = 0;
        foreach (var file in _results.ToArray())
        {
            total += await SearchService.CountInFileAsync(file.FilePath, options);
        }
        if (total <= 0)
        {
            _error = "Nenhuma ocorrência substituível nos arquivos listados.";
            StateHasChanged();
            return;
        }

        Confirm("Substituir em todos os arquivos",
            $"{total} {(total == 1 ? "ocorrência" : "ocorrências")} de \"{_term}\" serão alteradas em {_results.Count} {(_results.Count == 1 ? "arquivo" : "arquivos")}{EmptyNote}.",
            $"{_results.Count} {(_results.Count == 1 ? "arquivo" : "arquivos")} do projeto",
            "Substituir tudo",
            ReplaceAllAsync);
    }

    private string EmptyNote => string.IsNullOrEmpty(_replacement)
        ? " (o termo será removido)"
        : _regex ? " (a substituição é literal, sem referências de grupo)" : string.Empty;

    private async Task ReplaceInFileAsync(SearchFileResult file)
    {
        var replaced = await Search.ReplaceInFileAsync(file.FilePath, Options, _replacement);
        Ui.SetStatus($"Substituídas {replaced} ocorrências em {file.FileName}");
        await InvalidateRoslynAsync();
        await RunSearchAsync();
    }

    private async Task ReplaceAllAsync()
    {
        var replaced = 0;
        var files = _results.ToArray();
        foreach (var file in files)
        {
            replaced += await Search.ReplaceInFileAsync(file.FilePath, Options, _replacement);
        }
        Ui.SetStatus($"Substituídas {replaced} ocorrências em {files.Length} arquivos");
        await InvalidateRoslynAsync();
        await RunSearchAsync();
    }

    /// <summary>Invalida o cache do Roslyn para reindexar os arquivos alterados.</summary>
    private async Task InvalidateRoslynAsync()
    {
        if (_root is null)
        {
            return;
        }
        try
        {
            await JS.InvokeVoidAsync("xfIntellisense.invalidate", _root);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
            // página sem Monaco aberto: nada a invalidar
        }
        catch (InvalidOperationException)
        {
        }
    }

    private bool _showConfirm;
    private string _confirmTitle = string.Empty;
    private string _confirmMessage = string.Empty;
    private string? _confirmTarget;
    private string _confirmText = "Confirmar";
    private Func<Task>? _confirmAction;

    private void Confirm(string title, string message, string? target, string confirmText, Func<Task> action)
    {
        _confirmTitle = title;
        _confirmMessage = message;
        _confirmTarget = target;
        _confirmText = confirmText;
        _confirmAction = action;
        _showConfirm = true;
        StateHasChanged();
    }

    private Task OnConfirmChanged(bool open)
    {
        _showConfirm = open;
        if (!open)
        {
            _confirmAction = null;
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task RunConfirmAsync()
    {
        var action = _confirmAction;
        _confirmAction = null;
        _showConfirm = false;
        if (action is not null)
        {
            await action();
        }
        StateHasChanged();
    }

